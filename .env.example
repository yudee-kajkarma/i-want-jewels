# Backend API URL (required for products, cart, auth, etc.)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.example.com

# Public Microsoft Clarity project ID; replace with the company project for production.
NEXT_PUBLIC_CLARITY_PROJECT_ID=project-id

NEXT_PUBLIC_GOOGLE_CLIENT_ID=google-client-id

# Meta / Facebook Login — App ID only (public, appears in the page source)
NEXT_PUBLIC_META_APP_ID=meta-id
